{
	admin off
	auto_https off

	# 只有 Cloudflare 能连到这里（见下方 @cloudflare）。访客 IP 取 Cloudflare 自己写入的
	# CF-Connecting-IP：X-Forwarded-For 的开头部分访客可以随意伪造，不能用。网段需与下方保持一致。
	servers {
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

https://suversal.com:8443 {
	tls /etc/sue-notes-blog/tls/origin.pem /etc/sue-notes-blog/tls/origin.key

	# Cloudflare's published origin ranges, checked on 2026-09-22.
	# Loopback allows health checks from this host only.
	@cloudflare remote_ip 127.0.0.1/8 ::1/128 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

	handle @cloudflare {
		reverse_proxy 127.0.0.1:3100 {
			# 丢掉访客带来的转发头，只往下传上面认定的那一个地址。
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		respond 403
	}
}
