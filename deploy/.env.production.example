# Copy to a private file outside Git. Use URL-safe random hex for POSTGRES_PASSWORD.
PUBLIC_URL=https://blog.example.com
POSTGRES_PASSWORD=replace-with-random-hex
PAYLOAD_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
ARTALK_APP_KEY=replace-with-another-independent-random-secret
IMGBED_API_TOKEN=replace-with-the-existing-server-side-upload-token

# Optional if the image service addresses or channel differ from local defaults.
IMGBED_API_URL=https://img.suversal.com/
IMGBED_PUBLIC_BASE_URL=https://img.suversal.com/
IMGBED_UPLOAD_FOLDER=sue-notes-blog
IMGBED_CHANNEL_NAME=Tel_Channel
