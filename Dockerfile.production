FROM node:22.17.0-bookworm-slim

WORKDIR /app
RUN npm install --global pnpm@11.19.0

COPY --chown=node:node package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile

COPY --chown=node:node . .

# Next inlines NEXT_PUBLIC_* values when building. These credentials are deliberately
# placeholders: the real database and Payload secret are injected only at runtime.
RUN DATABASE_URL=postgres://build:build@127.0.0.1:1/unused \
    PAYLOAD_SECRET=build-time-placeholder-secret-32-chars \
    NEXT_PUBLIC_ARTALK_SERVER_URL=/artalk \
    pnpm build

RUN chown -R node:node /app/.next
USER node
ENV NODE_ENV=production
EXPOSE 3100
CMD ["pnpm", "exec", "next", "start", "--hostname", "0.0.0.0", "--port", "3100"]
