{
  "name": "sue-notes-blog",
  "version": "0.1.0",
  "description": "苏码手记博客与写作后台。",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --hostname 127.0.0.1 --port 3100",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev --hostname 127.0.0.1 --port 3100",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "check:fast": "pnpm lint && pnpm typecheck",
    "bootstrap:owner": "tsx scripts/bootstrap-owner.ts",
    "configure:local-admin": "tsx scripts/configure-local-admin.ts",
    "seed:demo": "cross-env NODE_ENV=production node --env-file=.env --import=tsx scripts/seed-demo-articles.ts",
    "smoke:blog": "tsx scripts/smoke-blog.ts",
    "test": "pnpm run test:unit && pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.unit.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@lexical/code": "0.41.0",
    "@lexical/html": "0.41.0",
    "@lexical/markdown": "0.41.0",
    "@lexical/react": "0.41.0",
    "@lexical/table": "0.41.0",
    "@lexical/utils": "0.41.0",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "artalk": "2.10.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lexical": "0.41.0",
    "mdast-util-from-markdown": "2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "2.1.2",
    "micromark-extension-gfm": "^3.0.0",
    "next": "16.3.3",
    "payload": "3.88.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2",
    "yauzl": "^3.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": "^11"
  }
}
